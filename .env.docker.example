# Telegram bot token from BotFather
BOT_TOKEN=telegram-bot-token

# dev | prod
APP_ENV=dev

# Docker runtime resolves relative app paths from /app
APP_BASE_DIR=/app

# Main application database inside docker-compose
DATABASE_URL=postgresql+asyncpg://flags:flags@db:5432/flags_train

# Local offline dataset paths inside the container
COUNTRIES_DATA_PATH=data/normalized/countries.json
FLAGS_DIR=data/flags

# Delay before the next question after answer feedback
QUIZ_AUTONEXT_SECONDS=1.2

# Application log level
LOG_LEVEL=INFO

# Optional Telegram user IDs allowed to open /admin
ADMIN_IDS=
